# URL of the SMS Movies backend. Do not include a trailing slash.
BACKEND_URL=http://localhost:8080

# Server-only Supabase credentials used for click-event ingestion.
# Use an sb_secret_ key (or the legacy service_role key), never a publishable key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Generate with: openssl rand -hex 32
# Changing this value prevents hashes from matching historical events.
IP_HASH_SALT=replace_with_a_random_64_character_hex_value
